<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Cyberarms.IntrusionDetection.Shared</AssemblyName>
    <RootNamespace>Cyberarms.IntrusionDetection.Shared</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- InstallationHelper uses System.Configuration.Install which does not exist in .NET 8.
       The Windows Service installer pattern will be replaced with UseWindowsService() in Wave 4. -->
  <ItemGroup>
    <Compile Remove="InstallationHelper.cs" />
    <Compile Remove="InstallationHelper.Designer.cs" />
  </ItemGroup>

  <!-- Remove the System.Threading implicit using to avoid Timer ambiguity with System.Timers.Timer -->
  <ItemGroup>
    <Using Remove="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyberarms.IntrusionDetection.Api\Cyberarms.IntrusionDetection.Api.csproj" />
  </ItemGroup>

</Project>
