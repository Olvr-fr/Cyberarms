<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>IntrusionDetectionAdmin</AssemblyName>
    <RootNamespace>Cyberarms.IntrusionDetection.Admin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyberarms.IntrusionDetection.Api\Cyberarms.IntrusionDetection.Api.csproj" />
    <ProjectReference Include="..\Cyberarms.IntrusionDetection.Shared\Cyberarms.IntrusionDetection.Shared.csproj" />
  </ItemGroup>

  <!-- Build agent plugins before Admin but do not reference their assemblies directly -->
  <ItemGroup>
    <ProjectReference Include="..\Cyberarms.Agents.Bind9\Cyberarms.Agents.Bind9.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.FileMaker\Cyberarms.Agents.FileMaker.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.FtpServer\Cyberarms.Agents.FtpServer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.MailServer\Cyberarms.Agents.MailServer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.MySql\Cyberarms.Agents.MySql.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.Smtp\Cyberarms.Agents.Smtp.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.SqlServer\Cyberarms.Agents.SqlServer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.TerminalServer\Cyberarms.Agents.TerminalServer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cyberarms.Agents.WebSecurity\Cyberarms.Agents.WebSecurity.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- After build: copy each agent DLL to $(OutputPath)\Plugins\ so the Admin discovers them -->
  <Target Name="CopyAgentsToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)Plugins" />
    <ItemGroup>
      <_AgentDll Include=
        "..\Cyberarms.Agents.Bind9\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.Bind9.dll;
         ..\Cyberarms.Agents.FileMaker\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.FileMaker.dll;
         ..\Cyberarms.Agents.FtpServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.FtpServer.dll;
         ..\Cyberarms.Agents.MailServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.MailServer.dll;
         ..\Cyberarms.Agents.MySql\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.MySql.dll;
         ..\Cyberarms.Agents.Smtp\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.Smtp.dll;
         ..\Cyberarms.Agents.SqlServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.SqlServer.dll;
         ..\Cyberarms.Agents.TerminalServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.TerminalServer.dll;
         ..\Cyberarms.Agents.WebSecurity\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.WebSecurity.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentDll)"
          DestinationFolder="$(OutputPath)Plugins"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

  <!-- After publish: copy agent DLLs to $(PublishDir)\Plugins\ for the deployed executable -->
  <Target Name="CopyAgentsToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Plugins" />
    <ItemGroup>
      <_AgentDllPub Include=
        "..\Cyberarms.Agents.Bind9\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.Bind9.dll;
         ..\Cyberarms.Agents.FileMaker\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.FileMaker.dll;
         ..\Cyberarms.Agents.FtpServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.FtpServer.dll;
         ..\Cyberarms.Agents.MailServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.MailServer.dll;
         ..\Cyberarms.Agents.MySql\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.MySql.dll;
         ..\Cyberarms.Agents.Smtp\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.Smtp.dll;
         ..\Cyberarms.Agents.SqlServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.SqlServer.dll;
         ..\Cyberarms.Agents.TerminalServer\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.TerminalServer.dll;
         ..\Cyberarms.Agents.WebSecurity\bin\$(Configuration)\$(TargetFramework)\Cyberarms.Agents.WebSecurity.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentDllPub)"
          DestinationFolder="$(PublishDir)Plugins"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
